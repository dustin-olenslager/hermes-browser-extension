{
  "manifest_version": 3,
  "name": "Hermes Browser Control",
  "version": "0.1.0",
  "description": "Lets a Hermes Agent drive the Chrome you are already signed into — over an authenticated, capability-limited channel.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hermes Browser Control",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
